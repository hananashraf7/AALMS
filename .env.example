# ── Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values

# Database URL (default: SQLite)
DATABASE_URL=sqlite:///./attendance.db

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Admin Defaults (set on first startup, change via dashboard)
DEFAULT_ADMIN_USERNAME=hananashraf
DEFAULT_ADMIN_PASSWORD=coldspot
DEFAULT_ADMIN_NAME=Hanan Ashraf
